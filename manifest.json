{
  "manifest_version": 3,
  "name": "Crosslist Helper",
  "version": "1.6.2",
  "description": "Extract an eBay listing, ask Claude to fill in every field, and auto-fill the Depop, Poshmark and Mercari sell forms.",
  "action": {
    "default_title": "Open Crosslist Helper"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["sidePanel", "scripting", "storage", "downloads", "tabs", "clipboardWrite"],
  "host_permissions": [
    "*://*.ebay.com/*",
    "*://*.ebay.ca/*",
    "*://*.ebay.co.uk/*",
    "*://*.ebay.com.au/*",
    "*://*.ebaydesc.com/*",
    "*://*.ebayimg.com/*",
    "*://*.depop.com/*",
    "*://*.poshmark.com/*",
    "*://*.mercari.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["*://*.depop.com/*", "*://*.poshmark.com/*", "*://*.mercari.com/*"],
      "js": ["filler.js"],
      "run_at": "document_idle"
    }
  ]
}
